func usage() {
	fmt.Println(`Calibrate split-specific sparse lexical hash-head dense fusion on dev, then apply the selected setting unchanged to test.

Required:
  EOS_REPO_ROOT=$PWD
  EOS_SPARSE_HEAD_CAL_DATASETS=scifact
  ferrous-wheel run scripts/calibrate_eos_sparse_lexical_head_hybrid.fw

Common knobs:
  EOS_SPARSE_HEAD_CAL_ARTIFACT=assets/corkscrewdb-default-embedder/corkscrewdb-default-embedder.mll
  EOS_SPARSE_HEAD_CAL_DATASET_ROOT=datasets/manta-embed-v1
  EOS_SPARSE_HEAD_CAL_DEV_SPLIT=dev
  EOS_SPARSE_HEAD_CAL_TEST_SPLIT=test
  EOS_SPARSE_HEAD_CAL_ALLOW_TRAIN_AS_DEV=1
  EOS_SPARSE_HEAD_CAL_METHODS=minmax,zscore,rrf
  EOS_SPARSE_HEAD_CAL_ALPHAS=0.25,0.50,0.75
  EOS_SPARSE_HEAD_CAL_FIXED_METHOD=zscore_blend
  EOS_SPARSE_HEAD_CAL_FIXED_ALPHA=0.25
  EOS_SPARSE_HEAD_CAL_MAX_QUERIES=5
  EOS_SPARSE_HEAD_CAL_FAIL_ON_PROTECTION=1`)
}

func getenv(name string, fallback string) string {
	value := strings.TrimSpace(os.Getenv(name))
	if value == "" {
		return fallback
	}
	return value
}

func splitList(value string) []string {
	out := []string{}
	for _, raw := range strings.Split(value, ",") {
		item := strings.TrimSpace(raw)
		if item != "" {
			out = append(out, item)
		}
	}
	return out
}

func parseFloatEnv(name string, fallback float64) (float64, error) {
	value := strings.TrimSpace(os.Getenv(name))
	if value == "" {
		return fallback, nil
	}
	parsed, err := strconv.ParseFloat(value, 64)
	guard err == nil else return 0, fmt.Errorf("%s must be a float: %w", name, err)
	return parsed, nil
}

func truthy(value string) bool {
	value = strings.ToLower(strings.TrimSpace(value))
	return value == "1" || value == "true" || value == "yes" || value == "on"
}

func hasRepoRoot(path string) bool {
	if path == "" {
		return false
	}
	if _, err := os.Stat(filepath.Join(path, "go.mod")); err != nil {
		return false
	}
	if _, err := os.Stat(filepath.Join(path, "cmd", "eos")); err != nil {
		return false
	}
	return true
}

func findRoot() (string, error) {
	if root := os.Getenv("EOS_REPO_ROOT"); root != "" {
		abs, err := filepath.Abs(root)
		guard err == nil else return "", err
		guard hasRepoRoot(abs) else return "", fmt.Errorf("EOS_REPO_ROOT does not look like the Eos repo: %s", abs)
		return abs, nil
	}
	pwd := os.Getenv("PWD")
	if hasRepoRoot(pwd) {
		return filepath.Abs(pwd)
	}
	cwd, err := os.Getwd()
	guard err == nil else return "", err
	if hasRepoRoot(cwd) {
		return filepath.Abs(cwd)
	}
	return "", fmt.Errorf("could not find repo root; set EOS_REPO_ROOT")
}

func absIfSet(value string) (string, error) {
	if strings.TrimSpace(value) == "" {
		return "", nil
	}
	return filepath.Abs(value)
}

func requireFile(label string, path string) error {
	info, err := os.Stat(path)
	guard err == nil else return fmt.Errorf("%s does not exist: %s", label, path)
	guard !info.IsDir() else return fmt.Errorf("%s must be a file: %s", label, path)
	return nil
}

func retrievalDatasetDir(root string, dataset string) string {
	candidate := filepath.Join(root, "raw", dataset, dataset)
	if info, err := os.Stat(candidate); err == nil && info.IsDir() {
		return candidate
	}
	return filepath.Join(root, dataset)
}

func qrelsPath(datasetDir string, split string) string {
	return filepath.Join(datasetDir, "qrels", split+".tsv")
}

func splitExists(datasetDir string, split string) bool {
	info, err := os.Stat(qrelsPath(datasetDir, split))
	return err == nil && !info.IsDir()
}

func shellQuote(value string) string {
	if value == "" {
		return "''"
	}
	if strings.ContainsAny(value, " \t\n'\"\\$`!*?[]{}()<>|&;") {
		return "'" + strings.ReplaceAll(value, "'", "'\\''") + "'"
	}
	return value
}

func renderCommand(name string, args []string) string {
	parts := []string{shellQuote(name)}
	for _, arg := range args {
		parts = append(parts, shellQuote(arg))
	}
	return strings.Join(parts, " ")
}

func safeName(value string) string {
	out := strings.ReplaceAll(value, "/", "_")
	out = strings.ReplaceAll(out, " ", "_")
	out = strings.ReplaceAll(out, ".", "p")
	out = strings.ReplaceAll(out, "-", "_")
	return out
}

func runCmd(cfg calConfig, label string, logName string, name string, args []string) error {
	logPath := filepath.Join(cfg.LogDir, logName)
	rendered := renderCommand(name, args)
	fmt.Println("+ " + rendered)
	err := os.WriteFile(logPath+".cmd", []byte(rendered+"\n"), 0o644)
	guard err == nil else return err
	logFile, err := os.Create(logPath)
	guard err == nil else return err
	defer logFile.Close()
	cmd := exec.Command(name, args...)
	cmd.Dir = cfg.Root
	cmd.Stdout = io.MultiWriter(os.Stdout, logFile)
	cmd.Stderr = io.MultiWriter(os.Stderr, logFile)
	err = cmd.Run()
	guard err == nil else return fmt.Errorf("%s failed; see %s: %w", label, logPath, err)
	return nil
}

func prepareConfig(root string) (calConfig, error) {
	runID := getenv("EOS_SPARSE_HEAD_CAL_RUN_ID", "eos-sparse-head-hybrid-calibration-"+time.Now().UTC().Format("20060102T150405Z"))
	runRoot, err := filepath.Abs(getenv("EOS_SPARSE_HEAD_CAL_RUN_ROOT", filepath.Join(root, "runs")))
	guard err == nil else return calConfig{}, err
	runDir := filepath.Join(runRoot, runID)
	if entries, err := os.ReadDir(runDir); err == nil && len(entries) > 0 {
		return calConfig{}, fmt.Errorf("run directory already exists and is not empty: %s", runDir)
	}
	err = os.MkdirAll(filepath.Join(runDir, "bin"), 0o755)
	guard err == nil else return calConfig{}, err
	err = os.MkdirAll(filepath.Join(runDir, "logs"), 0o755)
	guard err == nil else return calConfig{}, err

	artifact, err := filepath.Abs(getenv("EOS_SPARSE_HEAD_CAL_ARTIFACT", filepath.Join(root, "assets", "corkscrewdb-default-embedder", "corkscrewdb-default-embedder.mll")))
	guard err == nil else return calConfig{}, err
	err = requireFile("EOS_SPARSE_HEAD_CAL_ARTIFACT", artifact)
	guard err == nil else return calConfig{}, err

	datasetRoot, err := filepath.Abs(getenv("EOS_SPARSE_HEAD_CAL_DATASET_ROOT", filepath.Join(root, "datasets", "manta-embed-v1")))
	guard err == nil else return calConfig{}, err
	datasets := splitList(os.Getenv("EOS_SPARSE_HEAD_CAL_DATASETS"))
	guard len(datasets) > 0 else return calConfig{}, fmt.Errorf("EOS_SPARSE_HEAD_CAL_DATASETS is required")

	maxNDCG, err := parseFloatEnv("EOS_SPARSE_HEAD_CAL_MAX_NDCG10_REGRESSION", 0.0)
	guard err == nil else return calConfig{}, err
	maxRecall, err := parseFloatEnv("EOS_SPARSE_HEAD_CAL_MAX_RECALL100_REGRESSION", 0.0)
	guard err == nil else return calConfig{}, err

	return calConfig{
		Root:                root,
		RunID:               runID,
		RunRoot:             runRoot,
		RunDir:              runDir,
		LogDir:              filepath.Join(runDir, "logs"),
		EosBin:              filepath.Join(runDir, "bin", "eos"),
		Artifact:            artifact,
		DatasetRoot:         datasetRoot,
		Datasets:            datasets,
		DevSplit:            getenv("EOS_SPARSE_HEAD_CAL_DEV_SPLIT", "dev"),
		TestSplit:           getenv("EOS_SPARSE_HEAD_CAL_TEST_SPLIT", "test"),
		AllowTrainAsDev:     truthy(getenv("EOS_SPARSE_HEAD_CAL_ALLOW_TRAIN_AS_DEV", "1")),
		Methods:             splitList(getenv("EOS_SPARSE_HEAD_CAL_METHODS", "minmax,zscore,rrf")),
		Alphas:              splitList(getenv("EOS_SPARSE_HEAD_CAL_ALPHAS", "0.25,0.50,0.75")),
		RRFK:                getenv("EOS_SPARSE_HEAD_CAL_RRF_K", "60"),
		RRFLambda:           getenv("EOS_SPARSE_HEAD_CAL_RRF_LAMBDA", "1.0"),
		FixedMethod:         getenv("EOS_SPARSE_HEAD_CAL_FIXED_METHOD", "zscore_blend"),
		FixedAlpha:          getenv("EOS_SPARSE_HEAD_CAL_FIXED_ALPHA", "0.25"),
		TopTerms:            getenv("EOS_SPARSE_HEAD_CAL_TOP_TERMS", "128"),
		HashBins:            getenv("EOS_SPARSE_HEAD_CAL_HASH_BINS", "65536"),
		BatchSize:           getenv("EOS_SPARSE_HEAD_CAL_BATCH_SIZE", "64"),
		TopK:                getenv("EOS_SPARSE_HEAD_CAL_TOP_K", "100"),
		MaxDocs:             getenv("EOS_SPARSE_HEAD_CAL_MAX_DOCS", "0"),
		MaxQueries:          getenv("EOS_SPARSE_HEAD_CAL_MAX_QUERIES", "0"),
		MaxNDCG10Regression: maxNDCG,
		MaxRecallRegression: maxRecall,
		FailOnProtection:    truthy(os.Getenv("EOS_SPARSE_HEAD_CAL_FAIL_ON_PROTECTION")),
		SummaryJSON:         filepath.Join(runDir, "sparse_head_hybrid_calibration_summary.json"),
		SummaryTSV:          filepath.Join(runDir, "sparse_head_hybrid_calibration_summary.tsv"),
		SummaryMarkdown:     filepath.Join(runDir, "sparse_head_hybrid_calibration_summary.md"),
	}, nil
}

func normalizeMethod(raw string) string {
	method := strings.ToLower(strings.TrimSpace(raw))
	if method == "minmax_blend" {
		return "minmax"
	}
	if method == "zscore_blend" {
		return "zscore"
	}
	return method
}

func settingFor(method string, alpha string, rrfK string, rrfLambda string) setting {
	method = normalizeMethod(method)
	if method == "rrf" {
		return setting{Label: "hybrid_rrf_k" + rrfK + "_lambda" + rrfLambda, Method: "rrf", RRFK: rrfK, RRFLambda: rrfLambda}
	}
	return setting{Label: "hybrid_" + method + "_alpha" + alpha, Method: method, Alpha: alpha}
}

func fixedSetting(cfg calConfig) setting {
	return settingFor(cfg.FixedMethod, cfg.FixedAlpha, cfg.RRFK, cfg.RRFLambda)
}

func buildSettings(cfg calConfig) []setting {
	settings := []setting{}
	for _, rawMethod := range cfg.Methods {
		method := normalizeMethod(rawMethod)
		if method == "rrf" {
			settings = append(settings, settingFor(method, "", cfg.RRFK, cfg.RRFLambda))
			continue
		}
		for _, alpha := range cfg.Alphas {
			settings = append(settings, settingFor(method, alpha, cfg.RRFK, cfg.RRFLambda))
		}
	}
	return settings
}

func splitArtifactPaths(cfg calConfig, dataset string, split string) splitArtifacts {
	dir := filepath.Join(cfg.RunDir, safeName(dataset), safeName(split))
	vectorDir := filepath.Join(dir, "vectors")
	return splitArtifacts{
		Dataset:        dataset,
		Split:          split,
		Dir:            dir,
		LabelsPath:     filepath.Join(dir, "sparse-labels.jsonl"),
		LabelManifest:  filepath.Join(dir, "sparse-labels.manifest.json"),
		HeadPath:       filepath.Join(dir, "sparse-hash-head.json"),
		VectorDir:      vectorDir,
		VectorManifest: filepath.Join(vectorDir, "manifest.json"),
		DocVectors:     filepath.Join(vectorDir, "doc-vectors.jsonl"),
		QueryVectors:   filepath.Join(vectorDir, "query-vectors.jsonl"),
	}
}

func prepareSplitArtifacts(cfg calConfig, dataset string, split string, datasetDir string) (splitArtifacts, error) {
	art := splitArtifactPaths(cfg, dataset, split)
	err := os.MkdirAll(art.VectorDir, 0o755)
	guard err == nil else return splitArtifacts{}, err

	labelArgs := []string{"export-sparse-lexical-labels", "--dataset", dataset, "--split", split, "--top-terms", cfg.TopTerms, "--hash-bins", cfg.HashBins, "--oracle-top-k", cfg.TopK, "--manifest-json", art.LabelManifest}
	if cfg.MaxDocs != "" && cfg.MaxDocs != "0" {
		labelArgs = append(labelArgs, "--max-docs", cfg.MaxDocs)
	}
	if cfg.MaxQueries != "" && cfg.MaxQueries != "0" {
		labelArgs = append(labelArgs, "--max-queries", cfg.MaxQueries)
		labelArgs = append(labelArgs, "--oracle-max-queries", cfg.MaxQueries)
	}
	labelArgs = append(labelArgs, datasetDir, art.LabelsPath)
	err = runCmd(cfg, "Export sparse lexical labels "+dataset+" "+split, safeName(dataset+"."+split+".export-sparse-labels")+".log", cfg.EosBin, labelArgs)
	guard err == nil else return splitArtifacts{}, err

	headArgs := []string{"fit-sparse-lexical-head", "--dataset", dataset, "--split", split, "--labels", art.LabelsPath, "--hash-bins", cfg.HashBins, "--head-json", art.HeadPath}
	err = runCmd(cfg, "Fit sparse lexical head "+dataset+" "+split, safeName(dataset+"."+split+".fit-sparse-head")+".log", cfg.EosBin, headArgs)
	guard err == nil else return splitArtifacts{}, err

	vectorArgs := []string{"export-retrieval-vectors", "--dataset", dataset, "--split", split, "--batch-size", cfg.BatchSize, "--manifest-json", art.VectorManifest}
	if cfg.MaxDocs != "" && cfg.MaxDocs != "0" {
		vectorArgs = append(vectorArgs, "--max-docs", cfg.MaxDocs)
	}
	if cfg.MaxQueries != "" && cfg.MaxQueries != "0" {
		vectorArgs = append(vectorArgs, "--max-queries", cfg.MaxQueries)
	}
	vectorArgs = append(vectorArgs, cfg.Artifact, datasetDir, art.VectorDir)
	err = runCmd(cfg, "Export dense retrieval vectors "+dataset+" "+split, safeName(dataset+"."+split+".export-vectors")+".log", cfg.EosBin, vectorArgs)
	guard err == nil else return splitArtifacts{}, err
	return art, nil
}

func denseArgs(cfg calConfig, dataset string, split string, metricsPath string, perQueryPath string, datasetDir string, art splitArtifacts) []string {
	args := []string{"eval-retrieval-vectors", "--dataset", dataset, "--split", split, "--backend", "eos-sparse-head-cal-dense", "--artifact", cfg.Artifact, "--doc-vectors", art.DocVectors, "--query-vectors", art.QueryVectors, "--top-k", cfg.TopK, "--metrics-json", metricsPath, "--per-query-jsonl", perQueryPath}
	if cfg.MaxDocs != "" && cfg.MaxDocs != "0" {
		args = append(args, "--max-docs", cfg.MaxDocs)
	}
	if cfg.MaxQueries != "" && cfg.MaxQueries != "0" {
		args = append(args, "--max-queries", cfg.MaxQueries)
	}
	args = append(args, datasetDir)
	return args
}

func sparseArgs(cfg calConfig, dataset string, split string, metricsPath string, perQueryPath string, datasetDir string, art splitArtifacts) []string {
	args := []string{"eval-sparse-lexical-head", "--dataset", dataset, "--split", split, "--labels", art.LabelsPath, "--head-json", art.HeadPath, "--top-k", cfg.TopK, "--metrics-json", metricsPath, "--per-query-jsonl", perQueryPath}
	if cfg.MaxQueries != "" && cfg.MaxQueries != "0" {
		args = append(args, "--max-queries", cfg.MaxQueries)
	}
	args = append(args, datasetDir)
	return args
}

func hybridArgs(cfg calConfig, st setting, dataset string, split string, metricsPath string, perQueryPath string, datasetDir string, art splitArtifacts) []string {
	args := []string{"eval-sparse-lexical-head-vectors-hybrid", "--dataset", dataset, "--split", split, "--artifact", cfg.Artifact, "--doc-vectors", art.DocVectors, "--query-vectors", art.QueryVectors, "--labels", art.LabelsPath, "--head-json", art.HeadPath, "--top-k", cfg.TopK, "--metrics-json", metricsPath, "--per-query-jsonl", perQueryPath, "--method", st.Method}
	if st.Method == "rrf" {
		args = append(args, "--rrf-k", st.RRFK, "--rrf-lambda", st.RRFLambda)
	} else {
		args = append(args, "--alpha", st.Alpha)
	}
	if cfg.MaxDocs != "" && cfg.MaxDocs != "0" {
		args = append(args, "--max-docs", cfg.MaxDocs)
	}
	if cfg.MaxQueries != "" && cfg.MaxQueries != "0" {
		args = append(args, "--max-queries", cfg.MaxQueries)
	}
	args = append(args, datasetDir)
	return args
}

func readMetrics(path string) (retrievalMetrics, error) {
	data, err := os.ReadFile(path)
	guard err == nil else return retrievalMetrics{}, err
	var metrics retrievalMetrics
	err = json.Unmarshal(data, &metrics)
	guard err == nil else return retrievalMetrics{}, err
	return metrics, nil
}

func evalOne(cfg calConfig, dataset string, split string, baseline string, st setting, datasetDir string, art splitArtifacts) (evalResult, error) {
	prefix := safeName(dataset + "." + split + "." + baseline + "." + st.Label)
	metricsPath := filepath.Join(cfg.RunDir, prefix+".metrics.json")
	perQueryPath := filepath.Join(cfg.RunDir, prefix+".per-query.jsonl")
	var args []string
	if baseline == "dense" {
		args = denseArgs(cfg, dataset, split, metricsPath, perQueryPath, datasetDir, art)
	} else if baseline == "sparse" {
		args = sparseArgs(cfg, dataset, split, metricsPath, perQueryPath, datasetDir, art)
	} else {
		args = hybridArgs(cfg, st, dataset, split, metricsPath, perQueryPath, datasetDir, art)
	}
	err := runCmd(cfg, "Evaluate "+dataset+" "+split+" "+baseline+" "+st.Label, prefix+".log", cfg.EosBin, args)
	guard err == nil else return evalResult{}, err
	metrics, err := readMetrics(metricsPath)
	guard err == nil else return evalResult{}, err
	return evalResult{
		Dataset:      dataset,
		Split:        split,
		Baseline:     baseline,
		Label:        st.Label,
		Setting:      st,
		MetricsPath:  metricsPath,
		PerQueryPath: perQueryPath,
		Metrics:      metrics,
	}, nil
}

func better(a evalResult, b evalResult) bool {
	aq := a.Metrics.Quality
	bq := b.Metrics.Quality
	if aq.NDCGAt10 != bq.NDCGAt10 {
		return aq.NDCGAt10 > bq.NDCGAt10
	}
	if aq.MRRAt10 != bq.MRRAt10 {
		return aq.MRRAt10 > bq.MRRAt10
	}
	if aq.RecallAt100 != bq.RecallAt100 {
		return aq.RecallAt100 > bq.RecallAt100
	}
	return a.Label < b.Label
}

func protection(cfg calConfig, dataset string, dense evalResult, selected evalResult) protectionResult {
	ndcgDelta := selected.Metrics.Quality.NDCGAt10 - dense.Metrics.Quality.NDCGAt10
	recallDelta := selected.Metrics.Quality.RecallAt100 - dense.Metrics.Quality.RecallAt100
	ndcgBad := ndcgDelta < -cfg.MaxNDCG10Regression
	recallBad := recallDelta < -cfg.MaxRecallRegression
	return protectionResult{
		Dataset:                   dataset,
		Passed:                    !ndcgBad && !recallBad,
		MaxNDCG10Regression:       cfg.MaxNDCG10Regression,
		MaxRecall100Regression:    cfg.MaxRecallRegression,
		NDCG10DeltaVsDense:        ndcgDelta,
		Recall100DeltaVsDense:     recallDelta,
		NDCG10RegressedTooMuch:    ndcgBad,
		Recall100RegressedTooMuch: recallBad,
	}
}

func qrelsSplitForDev(cfg calConfig, datasetDir string) (string, bool, error) {
	if splitExists(datasetDir, cfg.DevSplit) {
		return cfg.DevSplit, false, nil
	}
	if cfg.AllowTrainAsDev && cfg.DevSplit != "train" && splitExists(datasetDir, "train") {
		return "train", true, nil
	}
	return "", false, fmt.Errorf("dev qrels split %q is missing at %s", cfg.DevSplit, qrelsPath(datasetDir, cfg.DevSplit))
}

func collectMissingAndSkipped(results []evalResult) (map[string]int, map[string]int) {
	missing := map[string]int{}
	skipped := map[string]int{}
	for _, res := range results {
		key := res.Split + "." + res.Baseline + "." + res.Label
		if res.Metrics.SparseLexical != nil {
			missing[key+".missing_query_labels"] = res.Metrics.SparseLexical.MissingQueryLabels
			missing[key+".missing_doc_labels"] = res.Metrics.SparseLexical.MissingDocLabels
		}
		skipped[key+".relevant_docs_without_text"] = res.Metrics.SkippedCounts.RelevantDocsWithoutText
		skipped[key+".queries_without_relevant_docs"] = res.Metrics.SkippedCounts.QueriesWithoutRelevantDocs
	}
	return missing, skipped
}

func runDataset(cfg calConfig, dataset string, settings []setting) (datasetSummary, error) {
	datasetDir := retrievalDatasetDir(cfg.DatasetRoot, dataset)
	info, err := os.Stat(datasetDir)
	guard err == nil && info.IsDir() else return datasetSummary{}, fmt.Errorf("dataset directory missing for %s: %s", dataset, datasetDir)
	devSplit, usedTrain, err := qrelsSplitForDev(cfg, datasetDir)
	guard err == nil else return datasetSummary{}, err
	guard splitExists(datasetDir, cfg.TestSplit) else return datasetSummary{}, fmt.Errorf("test qrels split %q is missing at %s", cfg.TestSplit, qrelsPath(datasetDir, cfg.TestSplit))

	devArtifacts, err := prepareSplitArtifacts(cfg, dataset, devSplit, datasetDir)
	guard err == nil else return datasetSummary{}, err
	testArtifacts, err := prepareSplitArtifacts(cfg, dataset, cfg.TestSplit, datasetDir)
	guard err == nil else return datasetSummary{}, err

	denseSetting := setting{Label: "dense_only", Method: "dense_only"}
	sparseSetting := setting{Label: "sparse_head_only", Method: "sparse_head_only"}
	fixed := fixedSetting(cfg)

	devDense, err := evalOne(cfg, dataset, devSplit, "dense", denseSetting, datasetDir, devArtifacts)
	guard err == nil else return datasetSummary{}, err
	devSparse, err := evalOne(cfg, dataset, devSplit, "sparse", sparseSetting, datasetDir, devArtifacts)
	guard err == nil else return datasetSummary{}, err
	devFixed, err := evalOne(cfg, dataset, devSplit, "hybrid", fixed, datasetDir, devArtifacts)
	guard err == nil else return datasetSummary{}, err
	devSweep := []evalResult{}
	for _, st := range settings {
		res, err := evalOne(cfg, dataset, devSplit, "hybrid", st, datasetDir, devArtifacts)
		guard err == nil else return datasetSummary{}, err
		devSweep = append(devSweep, res)
	}
	guard len(devSweep) > 0 else return datasetSummary{}, fmt.Errorf("no hybrid settings generated")
	sort.SliceStable(devSweep, func(i int, j int) bool {
		return better(devSweep[i], devSweep[j])
	})
	selectedDev := devSweep[0]

	testDense, err := evalOne(cfg, dataset, cfg.TestSplit, "dense", denseSetting, datasetDir, testArtifacts)
	guard err == nil else return datasetSummary{}, err
	testSparse, err := evalOne(cfg, dataset, cfg.TestSplit, "sparse", sparseSetting, datasetDir, testArtifacts)
	guard err == nil else return datasetSummary{}, err
	testFixed, err := evalOne(cfg, dataset, cfg.TestSplit, "hybrid", fixed, datasetDir, testArtifacts)
	guard err == nil else return datasetSummary{}, err
	testSelected, err := evalOne(cfg, dataset, cfg.TestSplit, "hybrid", selectedDev.Setting, datasetDir, testArtifacts)
	guard err == nil else return datasetSummary{}, err
	gate := protection(cfg, dataset, testDense, testSelected)
	allResults := append([]evalResult{devDense, devSparse, devFixed, selectedDev, testDense, testSparse, testFixed, testSelected}, devSweep...)
	missing, skipped := collectMissingAndSkipped(allResults)

	return datasetSummary{
		Dataset:             dataset,
		RequestedDevSplit:   cfg.DevSplit,
		SelectedSplit:       devSplit,
		TestSplit:           cfg.TestSplit,
		UsedTrainAsDev:      usedTrain,
		DevArtifacts:        devArtifacts,
		TestArtifacts:       testArtifacts,
		DevDense:            devDense,
		DevSparse:           devSparse,
		DevFixed:            devFixed,
		Selected:            selectedDev,
		TestDense:           testDense,
		TestSparse:          testSparse,
		TestFixed:           testFixed,
		TestSelected:        testSelected,
		ProtectionGate:      gate,
		DevSweep:            devSweep,
		MissingSparseLabels:  missing,
		SkippedRelevantDocs: skipped,
	}, nil
}

func tsvHeader() string {
	return "dataset\tselected_split\ttest_split\tused_train_as_dev\tfixed_label\tdev_selected_label\tdev_selected_ndcg_at_10\tdev_dense_ndcg_at_10\tdev_sparse_ndcg_at_10\tdev_fixed_ndcg_at_10\ttest_selected_ndcg_at_10\ttest_dense_ndcg_at_10\ttest_sparse_ndcg_at_10\ttest_fixed_ndcg_at_10\ttest_selected_recall_at_100\ttest_dense_recall_at_100\tndcg_at_10_delta_vs_dense\trecall_at_100_delta_vs_dense\tprotection_passed\tselected_test_metrics_path\n"
}

func writeOutputs(cfg calConfig, datasets []datasetSummary) error {
	fixed := fixedSetting(cfg)
	manifest := summaryManifest{
		Schema:              "eos.sparse_head_hybrid_calibration.v1",
		RunID:               cfg.RunID,
		RunDir:              cfg.RunDir,
		GeneratedAt:         time.Now().UTC().Format(time.RFC3339),
		Artifact:            cfg.Artifact,
		DatasetRoot:         cfg.DatasetRoot,
		TopTerms:            cfg.TopTerms,
		HashBins:            cfg.HashBins,
		FixedSetting:        fixed,
		SelectionRule:       "max dev ndcg_at_10; tie-break mrr_at_10 then recall_at_100; apply selected setting unchanged to test",
		ProtectionThreshold: fmt.Sprintf("selected test hybrid must not trail dense by more than ndcg_at_10=%.6f and recall_at_100=%.6f", cfg.MaxNDCG10Regression, cfg.MaxRecallRegression),
		Caveat:              "Experimental split-specific hashed sparse-label sidecar calibration; not a trained neural sparse head, dense model promotion, or default asset/alias change.",
		Datasets:            datasets,
	}
	data, err := json.MarshalIndent(manifest, "", "  ")
	guard err == nil else return err
	err = os.WriteFile(cfg.SummaryJSON, append(data, '\n'), 0o644)
	guard err == nil else return err

	tsv := strings.Builder{}
	tsv.WriteString(tsvHeader())
	for _, ds := range datasets {
		tsv.WriteString(fmt.Sprintf("%s\t%s\t%s\t%t\t%s\t%s\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%.15f\t%+.15f\t%+.15f\t%t\t%s\n",
			ds.Dataset,
			ds.SelectedSplit,
			ds.TestSplit,
			ds.UsedTrainAsDev,
			fixed.Label,
			ds.Selected.Label,
			ds.Selected.Metrics.Quality.NDCGAt10,
			ds.DevDense.Metrics.Quality.NDCGAt10,
			ds.DevSparse.Metrics.Quality.NDCGAt10,
			ds.DevFixed.Metrics.Quality.NDCGAt10,
			ds.TestSelected.Metrics.Quality.NDCGAt10,
			ds.TestDense.Metrics.Quality.NDCGAt10,
			ds.TestSparse.Metrics.Quality.NDCGAt10,
			ds.TestFixed.Metrics.Quality.NDCGAt10,
			ds.TestSelected.Metrics.Quality.RecallAt100,
			ds.TestDense.Metrics.Quality.RecallAt100,
			ds.ProtectionGate.NDCG10DeltaVsDense,
			ds.ProtectionGate.Recall100DeltaVsDense,
			ds.ProtectionGate.Passed,
			ds.TestSelected.MetricsPath))
	}
	err = os.WriteFile(cfg.SummaryTSV, []byte(tsv.String()), 0o644)
	guard err == nil else return err

	md := []string{
		"# Sparse Lexical Hash-Head Hybrid Calibration",
		"",
		"Dev split selects the split-specific sparse lexical hash-head dense fusion setting by nDCG@10, with MRR@10 and recall@100 tie-breakers. The selected setting is then applied unchanged to the test split.",
		"",
		"## Summary",
		"",
		"| dataset | selected split | selected | fixed | test nDCG@10 | dense test nDCG@10 | sparse test nDCG@10 | fixed test nDCG@10 | recall@100 delta vs dense | protection |",
		"| --- | --- | --- | --- | ---: | ---: | ---: | ---: | ---: | --- |",
	}
	for _, ds := range datasets {
		status := "pass"
		if !ds.ProtectionGate.Passed {
			status = "fail"
		}
		selectedSplit := ds.SelectedSplit
		if ds.UsedTrainAsDev {
			selectedSplit = selectedSplit + " (train fallback)"
		}
		md = append(md, fmt.Sprintf("| `%s` | `%s` | `%s` | `%s` | `%.15f` | `%.15f` | `%.15f` | `%.15f` | `%+.15f` | `%s` |",
			ds.Dataset,
			selectedSplit,
			ds.Selected.Label,
			fixed.Label,
			ds.TestSelected.Metrics.Quality.NDCGAt10,
			ds.TestDense.Metrics.Quality.NDCGAt10,
			ds.TestSparse.Metrics.Quality.NDCGAt10,
			ds.TestFixed.Metrics.Quality.NDCGAt10,
			ds.ProtectionGate.Recall100DeltaVsDense,
			status))
	}
	md = append(md,
		"",
		"## Artifacts",
		"",
		"- Summary JSON: `"+cfg.SummaryJSON+"`",
		"- Summary TSV: `"+cfg.SummaryTSV+"`",
		"- Command logs: `"+cfg.LogDir+"`",
		"",
		"Each dataset/split directory contains sparse labels, the label manifest, the fitted experimental hash-head sidecar, dense vector exports, dense-only metrics, sparse-only metrics, fixed hybrid metrics, and dev-selected hybrid metrics.",
		"",
		"## Caveat",
		"",
		"This harness calibrates an experimental split-specific hashed sparse-label sidecar. It is not a trained neural sparse head, not dense model promotion, not a shipped/default asset change, and not a default alias change.",
		"")
	err = os.WriteFile(cfg.SummaryMarkdown, []byte(strings.Join(md, "\n")), 0o644)
	guard err == nil else return err
	return nil
}

func run(cfg calConfig) error {
	settings := buildSettings(cfg)
	guard len(settings) > 0 else return fmt.Errorf("no hybrid settings generated")
	err := runCmd(cfg, "Build eos CLI", "go-build.log", "go", []string{"build", "-trimpath", "-o", cfg.EosBin, "./cmd/eos"})
	guard err == nil else return err
	datasets := []datasetSummary{}
	protectionFailed := false
	for _, dataset := range cfg.Datasets {
		summary, err := runDataset(cfg, dataset, settings)
		guard err == nil else return err
		if !summary.ProtectionGate.Passed {
			protectionFailed = true
		}
		datasets = append(datasets, summary)
	}
	err = writeOutputs(cfg, datasets)
	guard err == nil else return err
	fmt.Println("sparse_head_hybrid_calibration_json=" + cfg.SummaryJSON)
	fmt.Println("sparse_head_hybrid_calibration_tsv=" + cfg.SummaryTSV)
	fmt.Println("sparse_head_hybrid_calibration_markdown=" + cfg.SummaryMarkdown)
	if protectionFailed && cfg.FailOnProtection {
		return fmt.Errorf("sparse head hybrid protection gate failed")
	}
	return nil
}

func main() {
	if len(os.Args) > 1 && (os.Args[1] == "-h" || os.Args[1] == "--help") {
		usage()
		return
	}
	root, err := findRoot()
	if err != nil {
		fmt.Println(err)
		os.Exit(1)
	}
	cfg, err := prepareConfig(root)
	if err != nil {
		fmt.Println(err)
		os.Exit(1)
	}
	if err := run(cfg); err != nil {
		fmt.Println(err)
		os.Exit(1)
	}
}
