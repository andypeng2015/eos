	Methods             []string
	Alphas              []string
	RRFK                string
	RRFLambda           string
	FixedMethod         string
	FixedAlpha          string
	TopTerms            string
	HashBins            string
	BatchSize           string
	TopK                string
	MaxDocs             string
	MaxQueries          string
	MaxNDCG10Regression float64
	MaxRecallRegression float64
	FailOnProtection    bool
	SummaryJSON         string
	SummaryTSV          string
